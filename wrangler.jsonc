{
  // rental-home — 첨단대라수1차(DAELASOO) 공개 + 직원 겸용 사이트. 아이파크(site_Ipark) · OP(site_op)와 완전히 따로 (2026-11-13)
  // Cloudflare 계정 onegonginn@gmail.com · 주소 https://rental-home.onegongin.workers.dev (단지는 /daelasoo/ 아래)
  "name": "rental-home",
  "compatibility_date": "2026-10-06",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 서버 자리 자동 조정: 한국 손님이 LA 쪽으로 연결돼도 DB(APAC) 가까이에서 서버 코드를 돌림 (아이파크 2026-11-05 속도 경험)
  "placement": { "mode": "smart" },
  // SITE_URL = 단지 주소 (경로 /daelasoo 포함). 사이트맵 · RSS · 검색용 페이지 · 알림 링크 · robots.txt 가 모두 이 값을 씀
  //   검색용 페이지(/daelasoo/plan · /daelasoo/listings · /daelasoo/sitemap.xml …)는 서버가 이 경로 아래에서만 만든다 (src/worker.js)
  // DB_DRIVER: "d1"(지금) | "supabase"(필요할 때, _설계서/Supabase_전환_안내.md)
  "vars": { "SITE_URL": "https://rental-home.onegongin.workers.dev/daelasoo", "DB_DRIVER": "d1" },
  "compatibility_flags": ["nodejs_compat"],
  // 아침 요약 매일 08:30 (UTC 23:30) · 자동 백업 매일 03:00 (UTC 18:00)
  "triggers": { "crons": ["30 23 * * *", "0 18 * * *"] },
  // R2 저장소 — 배포(R5) 전에 Cloudflare 에서 만든다. 로컬 wrangler dev 는 자동으로 흉내
  "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "rental-home-backup" }, { "binding": "MEDIA", "bucket_name": "rental-home-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      // 새 DB — 아이파크 hwip-db 와 연결 없음. 배포(R5) 때 `npx.cmd wrangler d1 create rental-home-db --location apac` 로 받은 id 로 바꾼다
      "database_name": "rental-home-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "DB"
    }
  ]
}
